// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The slate lives in data/today.json, not here. The Neon TodayMatch table was
// written only by POST /api/refresh, which could not reach ESPN and slugified
// player ids; the daily workflow published today.json that nothing read. The
// table is left in the database for now — dropping it is a manual step, not a
// side effect of a schema edit.

model Bet {
  id               String     @id @default(cuid())
  matchExternalId  String
  playerExternalId String
  playerName       String
  matchDesc        String
  betType          BetType    @default(MONEYLINE)
  signal           Signal
  modelProb        Float
  impliedProb      Float
  edge             Float
  odds             Float
  closingOdds      Float?
  stake            Float
  toWin            Float?
  status           BetStatus  @default(OPEN)
  result           BetResult?
  pnl              Float?
  clv              Float?
  notes            String?
  placedAt         DateTime   @default(now())
  settledAt        DateTime?
  updatedAt        DateTime   @updatedAt

  @@index([status])
  @@index([placedAt])
  @@index([playerExternalId])
  @@index([matchExternalId])
}

model PageView {
  id        String   @id @default(cuid())
  site      String   // rallyiq | paddockiq | dugoutiq | landing
  path      String
  ip        String?
  city      String?
  region    String?
  country   String?
  isp       String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([site])
  @@index([createdAt])
}

model Bankroll {
  id        String   @id @default(cuid())
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

model BankrollSnapshot {
  id         String   @id @default(cuid())
  balance    Float
  snapshotAt DateTime @default(now())

  @@index([snapshotAt])
}

enum Signal {
  BET
  LEAN
  PASS
}

enum BetType {
  MONEYLINE
  SPREAD
  TOTAL_OVER
  TOTAL_UNDER
  SET_BETTING
}

enum BetStatus {
  OPEN
  SETTLED
  VOID
  CANCELLED
}

enum BetResult {
  WIN
  LOSS
  PUSH
  HALF_WIN
  HALF_LOSS
}